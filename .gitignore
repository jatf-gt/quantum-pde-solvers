# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environments. qiskit_hw/ is the second, Qiskit 2.x environment used
# only for real-device submission; see README section 2.1.
qiskit_hw/
.venv*/
venv/
env/

# Editor and tool caches
.vscode/
.pytest_cache/

# Bulk results: The per-solution fields live in the Zenodo deposit named in 
# results/README.md and the figures regenerate from the archives. The two 
# negations keep what the dissertation's numbers actually rest on.
*.npz
!results/qsvt_phase_cache/*.npz
*.csv
!results/**/*.csv
*.png
*.jpg
*.pdf
*.xlsx

# Cluster logs.
*.log
*.err
*.out

# Supervisor meeting material
results/meetings/
